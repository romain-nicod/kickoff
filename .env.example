# ── The one mechanism for keys — golden rule 28 ──────────────────────────
#
# Every key the application reads lives in .env, which .gitignore covers.
# This file is its versioned twin: the same variable names, no values.
#
#   cp .env.example .env    # then fill in your own values
#
# Adding a variable? Add it here in the SAME commit, with an empty value.
# This file is how the next person finds out the variable exists — and the
# only place they can look, since .env never leaves anyone's machine.
#
# In production there is no .env: the values are the host's secrets.
# ─────────────────────────────────────────────────────────────────────────

# One line per variable, grouped, each with what it is for.
# Example:
# STRIPE_KEY=          # payments — test key in dev, live key as a host secret

# ── Errors — Sentry ──────────────────────────────────────────────────────
# Empty: nothing is reported. bin/recette removes it, so a recette never
# reports into the production project.
SENTRY_DSN=

# ── Emails ───────────────────────────────────────────────────────────────
# Production: the Infomaniak SMTP relay. Recette: Mailpit on 127.0.0.1,
# written in .env.recette.local (docs/RECETTE.md). Tests: no network.
# Where the values live and how the relay is tested: vault note
# dev/outils/Emails - Envoi SMTP Infomaniak et tests Mailpit.md
SMTP_ADDRESS=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
# An address of a domain the authenticated mailbox may send for:
# SPF and DMARC reject any other.
EMAIL_FROM=
EMAIL_REPLY_TO=
# One switch per feature that sends real emails, off while empty, turned
# on only after a successful recette. Example:
# ALERTS_EMAIL_ENABLED=

# Production only — set these as host secrets, never in a file.
# RAILS_MASTER_KEY=
# DATABASE_URL=
