#!/usr/bin/env python3
"""Initialise a project from the kickoff template.

Reads kickoff.yml, substitutes every placeholder, merges the chosen
stack layer, then deletes what belongs to the template and not to the
project — including this script.

    bin/kickoff            # do it
    bin/kickoff --dry-run  # say what would happen

Runs on a plain Python 3, no dependency: kickoff.yml is parsed as flat
`key: value` lines on purpose.
"""

import argparse
import re
import shutil
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
CONFIG = ROOT / "kickoff.yml"

# Files and directories that belong to the template, not to a project.
# `skills` goes too: project-kickoff has done its job by the time this
# script runs, and the project it creates has no use for it.
TEMPLATE_ONLY = ["KICKOFF.md", "kickoff.yml", "stacks", "skills", "bin/kickoff"]

# Documents that only mean something to a team. On a solo project they
# are not "a bit of overhead": a CEREMONIES.md nobody holds discredits
# the documents next to it. Removed when team_size is 1 — the template
# deletes, it never derives, so the wording of what stays is untouched.
TEAM_ONLY = ["ROLES.md", "TEAM_CHARTER.md", "CEREMONIES.md",
             "docs/STANDUP.md", "docs/ONBOARDING.md"]

# The paragraphs pointing at them, marked in the files themselves.
# Solo: the whole block goes. Otherwise only the two marker lines do —
# template plumbing has no business in the project being created.
TEAM_BLOCK = re.compile(
    r"[ \t]*<!-- team-only -->\n.*?[ \t]*<!-- /team-only -->\n",
    re.DOTALL)
TEAM_MARKER = re.compile(r"[ \t]*<!-- /?team-only -->\n")

# Text files we substitute into. Everything else is copied untouched.
TEXT_SUFFIXES = {".md", ".yml", ".yaml", ".py", ".erb", ".html", ".css",
                 ".js", ".rb", ".example", ".txt", ""}

SKIP_DIRS = {".git", "node_modules", "tmp", "log", "vendor"}


def read_config():
    if not CONFIG.exists():
        sys.exit("kickoff.yml is missing — are you at the root of the repository?")

    values = {}
    for line in CONFIG.read_text(encoding="utf-8").splitlines():
        line = line.strip()
        if not line or line.startswith("#") or ":" not in line:
            continue
        key, _, value = line.partition(":")
        values[key.strip()] = value.strip()

    missing = [k for k in ("project_name", "repo", "stack") if not values.get(k)]
    if missing:
        sys.exit(f"kickoff.yml: missing value for {', '.join(missing)}")
    if values["repo"] == "owner/repo" or values["project_name"] == "My Project":
        sys.exit("kickoff.yml still holds its example values — fill it in first.")

    owner, _, name = values["repo"].partition("/")
    capacity = (float(values.get("dev_days", 10))
                * float(values.get("team_size", 4))
                * float(values.get("velocity", 2.5)))

    return {
        "PROJECT_NAME": values["project_name"],
        "REPO": values["repo"],
        "OWNER": owner,
        "REPO_NAME": name,
        "TAGLINE": values.get("tagline", ""),
        "STACK": values["stack"],
        "DEV_DAYS": values.get("dev_days", "10"),
        "TEAM_SIZE": values.get("team_size", "4"),
        "VELOCITY": values.get("velocity", "2.5"),
        "CAPACITY": str(int(capacity)),
        "LANGUAGE": values.get("language", "en"),
    }


def files_to_process():
    for path in ROOT.rglob("*"):
        if not path.is_file():
            continue
        # Relative to ROOT, never the absolute path: a repository cloned
        # under a directory called tmp/, log/ or vendor/ would otherwise
        # have every one of its files skipped, and the substitution would
        # silently do nothing.
        if any(part in SKIP_DIRS for part in path.relative_to(ROOT).parts):
            continue
        if path.suffix in TEXT_SUFFIXES or path.suffix == "":
            yield path


def substitute(values, dry_run):
    pattern = re.compile(r"\{\{([A-Z_]+)\}\}")
    unknown, touched = set(), 0

    for path in files_to_process():
        try:
            text = path.read_text(encoding="utf-8")
        except (UnicodeDecodeError, PermissionError):
            continue
        if "{{" not in text:
            continue

        def replace(match):
            key = match.group(1)
            if key in values:
                return values[key]
            unknown.add(key)
            return match.group(0)

        new_text = pattern.sub(replace, text)
        if new_text != text:
            touched += 1
            if not dry_run:
                path.write_text(new_text, encoding="utf-8")

    print(f"  {touched} files rewritten")
    if not touched:
        print("  ⚠️  nothing was substituted — expected at least README.md. "
              "Are you at the root of the repository?")
    if unknown:
        print(f"  ⚠️  unknown placeholders left as-is: {', '.join(sorted(unknown))}")


def apply_stack(stack, dry_run):
    if stack in ("none", ""):
        print("  no stack layer")
        return

    layer = ROOT / "stacks" / stack
    if not layer.is_dir():
        available = sorted(p.name for p in (ROOT / "stacks").iterdir() if p.is_dir())
        sys.exit(f"unknown stack '{stack}' — available: {', '.join(available)}, or none")

    for source in sorted(layer.rglob("*")):
        if not source.is_file() or source.name == "README.md":
            continue
        relative = source.relative_to(layer)

        # foo.append.md is appended to foo.md instead of replacing it.
        if source.name.endswith(".append.md"):
            target = ROOT / relative.parent / source.name.replace(".append.md", ".md")
            if target.exists():
                print(f"  append  {target.relative_to(ROOT)}")
                if not dry_run:
                    target.write_text(
                        target.read_text(encoding="utf-8").rstrip()
                        + "\n\n" + source.read_text(encoding="utf-8").lstrip(),
                        encoding="utf-8")
                continue

        target = ROOT / relative
        print(f"  copy    {relative}")
        if not dry_run:
            target.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(source, target)


def apply_team_size(values, dry_run):
    """Solo project: remove the team documents and the links to them.

    Deleting is not deriving. The template still refuses to rewrite a
    sentence according to a profile; it only declines to ship a document
    whose subject does not exist here.
    """
    solo = str(values.get("TEAM_SIZE", "")).strip() in ("1", "1.0")

    if solo:
        print("Solo project — team documents removed")
        for name in TEAM_ONLY:
            path = ROOT / name
            if not path.exists():
                continue
            print(f"  remove  {name}")
            if not dry_run:
                path.unlink()

    template_paths = {ROOT / name for name in TEMPLATE_ONLY}
    for path in files_to_process():
        # bin/kickoff carries the marker in its own source; the stack
        # layers and the skills directory are deleted right after. None
        # of them is part of the project being created.
        if any(path == q or q in path.parents for q in template_paths):
            continue
        try:
            text = path.read_text(encoding="utf-8")
        except (UnicodeDecodeError, PermissionError):
            continue
        if "team-only" not in text:
            continue
        if solo:
            print(f"  unlink  {path.relative_to(ROOT)}")
        if not dry_run:
            pattern = TEAM_BLOCK if solo else TEAM_MARKER
            path.write_text(pattern.sub("", text), encoding="utf-8")


def clean_up(dry_run):
    for name in TEMPLATE_ONLY:
        path = ROOT / name
        if not path.exists():
            continue
        print(f"  remove  {name}")
        if dry_run:
            continue
        shutil.rmtree(path) if path.is_dir() else path.unlink()

        # Deleting bin/kickoff leaves bin/ empty. Git does not track an
        # empty directory, so it survives only on the machine that ran
        # this — and then `rails new` writes its binstubs into a folder
        # that exists here and not in the clone.
        parent = path.parent
        if parent != ROOT and parent.is_dir() and not any(parent.iterdir()):
            print(f"  remove  {parent.relative_to(ROOT)}/ (now empty)")
            parent.rmdir()


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--dry-run", action="store_true")
    args = parser.parse_args()

    values = read_config()

    print(f"\n{values['PROJECT_NAME']} · {values['REPO']} · stack "
          f"{values['STACK']}")
    print(f"capacity: {values['DEV_DAYS']} days × {values['TEAM_SIZE']} people "
          f"× {values['VELOCITY']} = {values['CAPACITY']} points\n")

    # The stack layer FIRST: its files land in the tree before the
    # substitution walks it, so a {{PLACEHOLDER}} written in a layer is
    # replaced like any other. The reverse order copied them untouched,
    # and the failure was silent.
    print("Stack layer")
    apply_stack(values["STACK"], args.dry_run)
    print("Substituting")
    substitute(values, args.dry_run)
    apply_team_size(values, args.dry_run)
    print("Cleaning up")
    clean_up(args.dry_run)

    if args.dry_run:
        print("\nDry run — nothing was written.")
        return

    solo = str(values.get("TEAM_SIZE", "")).strip() in ("1", "1.0")
    gaps = ("""     docs/MILESTONES.md  the dates, derived from the demo date
     docs/GO_LIVE.md     where your host's rollback button is"""
            if solo else
            """     ROLES.md            the names behind each hat
     TEAM_CHARTER.md     each person's real working hours
     docs/MILESTONES.md  the dates, derived from the demo date
     docs/GO_LIVE.md     where your host's rollback button is""")

    print(f"""
Done. What is left for you:

  1. Fill in the gaps left on purpose:
{gaps}

  2. Configure the repository itself — labels, wiki, protected branch:

     python3 scripts/setup_repo.py

  2b. On the rails layer, AFTER `rails new` with the boilerplate:

     python3 scripts/after_rails_new.py

     The boilerplate deletes the CI workflow, overwrites .rubocop.yml,
     and leaves tmp/ and log/ tracked. All three are silent. Skipping
     this step is how a repository ends up with no checks on its pull
     requests and 1700 runtime files in its history.

  3. Write the specification in docs/, then populate GitHub:

     python3 scripts/build_backlog.py
     python3 scripts/create_issues.py
     python3 scripts/create_epic_issues.py
     python3 scripts/setup_project.py       # needs: gh auth refresh -s project

  4. Commit, and read GOLDEN_RULES.md out loud at the kick-off.
""")


if __name__ == "__main__":
    main()
